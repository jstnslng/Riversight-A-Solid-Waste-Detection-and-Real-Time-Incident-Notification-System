# Copy to .env in this directory. Never commit the populated file.
# Direct RTSP playback URL (including RTSP.ME); keep push keys private.
CAMERA_RTSP_URL=
# HTTPS deployment base URL, without /predict, query strings or credentials.
ULTRALYTICS_ENDPOINT=
ULTRALYTICS_API_KEY=
# Optional minimum start-to-start sampling interval (1 to 86400 seconds).
DETECTION_INTERVAL_SECONDS=5
SEGMENTATION_INTERVAL_SECONDS=2
# Local stream target FPS (1-15), independent of cloud inference. 0 restores snapshots.
SEGMENTATION_STREAM_FPS=10
# Classical optical-flow visualization only; false keeps current raw MJPEG video.
SEGMENTATION_TRACKING_ENABLED=true
# Seconds since the YOLO source frame, including cloud latency (0.5-10).
# Provisional conservative default; inspect health latency before tuning.
SEGMENTATION_TRACK_MAX_AGE_SECONDS=3.0
SEGMENTATION_FEED_HOST=127.0.0.1
SEGMENTATION_FEED_PORT=5001
# These are local example values. On Railway use HOST=0.0.0.0 and omit
# SEGMENTATION_FEED_PORT to use injected PORT, or explicitly match its port.
# Production defaults: 0.0.0.0 and PORT (falling back to 5001).
# Optional for local development. Required for production_server.py:
# comma-separated exact HTTP Host authorities (hostname with port when used).
# Set to the ingress/backend hostname and the internal health-check authority.
# Never use a wildcard. Forward Host unchanged at the reverse proxy.
# SEGMENTATION_ALLOWED_HOSTS=
# Public Firestore camera_feeds document ID of the physical bridge camera.
# Leave blank until verified: the UI will use live fallback rather than guess.
# Use the document ID, not camId/title. Restart segmentation_feed.py after setting.
SEGMENTATION_CAMERA_DOC_ID=
# Comma-separated exact frontend origins; no wildcard or trailing slash.
SEGMENTATION_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
# Production: replace this list with exact HTTPS frontend origins.
# Production container: set SEGMENTATION_FEED_HOST=0.0.0.0 at runtime,
# keeping the container port private behind an authenticated HTTPS ingress.
