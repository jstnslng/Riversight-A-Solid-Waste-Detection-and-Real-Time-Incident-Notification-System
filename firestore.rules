rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdministrator() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Administrator";
    }

    function isMonitoringUser() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Monitoring"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("status", "active") == "active";
    }

    function canAccessMonitoringData() {
      return isAdministrator() || isMonitoringUser();
    }

    match /detections/{detectionId} {
      allow read, update: if canAccessMonitoringData();
    }

    match /incidents/{incidentId} {
      allow read, create: if canAccessMonitoringData();

      match /events/{eventId} {
        allow read, create: if canAccessMonitoringData();
      }
    }

    match /reports/{reportId} {
      allow read, create: if canAccessMonitoringData();
    }

    match /camera_feeds/{cameraId} {
      allow read: if canAccessMonitoringData();
      allow create, update, delete: if isAdministrator();
    }

  }
}