rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdministrator() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Administrator";
    }

    function isMonitoringUser() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["Monitoring", "Monitoring Personnel"]
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("status", "Active") in ["active", "Active"];
    }

    function canAccessMonitoringData() {
      return isAdministrator() || isMonitoringUser();
    }

    match /users/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isAdministrator());
      allow list: if isAdministrator();
      allow create: if isAdministrator()
        || (request.auth != null
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.role == "Monitoring Personnel"
          && request.resource.data.status == "Active");
      allow update: if isAdministrator()
        || (request.auth != null
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "username", "email_address", "phone_no", "phoneNumber",
            "lastLogin", "last_login", "status", "updated_at"
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"])
            || (resource.data.status == "pending" && request.resource.data.status == "active")));
      allow delete: if isAdministrator();
    }

    match /audit/{auditId} {
      allow read: if isAdministrator();
      allow create: if request.auth != null && canAccessMonitoringData();
    }

    match /detections/{detectionId} {
      allow read, update: if canAccessMonitoringData();
    }

    match /incidents/{incidentId} {
      allow read, create: if canAccessMonitoringData();

      match /events/{eventId} {
        allow read, create: if canAccessMonitoringData();
      }
    }

    match /reports/{reportId} {
      allow read, create: if canAccessMonitoringData();
    }

    match /cleanup_requests/{requestId} {
      allow read: if canAccessMonitoringData();
      allow create: if canAccessMonitoringData()
        && request.resource.data.keys().hasOnly([
          "cameraDocId", "cameraId", "location", "requestedAt",
          "requestedByUid", "requestedByEmail", "status"
        ])
        && request.resource.data.keys().hasAll([
          "cameraDocId", "cameraId", "location", "requestedAt",
          "requestedByUid", "status"
        ])
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.requestedAt == request.time
        && request.resource.data.status == "pending_acknowledgment";
      allow update: if canAccessMonitoringData()
        && (
          (
            resource.data.status == "pending_acknowledgment"
            && request.resource.data.status == "acknowledged"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status", "acknowledgedAt", "acknowledgedByUid", "acknowledgedByEmail"
            ])
            && request.resource.data.diff(resource.data).affectedKeys().hasAll([
              "status", "acknowledgedAt", "acknowledgedByUid"
            ])
            && request.resource.data.acknowledgedAt == request.time
            && request.resource.data.acknowledgedByUid == request.auth.uid
          )
          || (
            resource.data.status == "acknowledged"
            && request.resource.data.status == "verified"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status", "cleanupOutcome", "verifiedAt", "verifiedByUid", "verifiedByEmail"
            ])
            && request.resource.data.diff(resource.data).affectedKeys().hasAll([
              "status", "cleanupOutcome", "verifiedAt", "verifiedByUid"
            ])
            && request.resource.data.cleanupOutcome in ["successful", "unsuccessful"]
            && request.resource.data.verifiedAt == request.time
            && request.resource.data.verifiedByUid == request.auth.uid
          )
        );
      allow delete: if false;
    }

    match /camera_feeds/{cameraId} {
      allow read: if canAccessMonitoringData();
      allow create, update, delete: if isAdministrator();
    }

  }
}