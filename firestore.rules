rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdministrator() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Administrator";
    }

    function isMonitoringUser() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["Monitoring", "Monitoring Personnel"]
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("status", "Active") in ["active", "Active"];
    }

    function canAccessMonitoringData() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        isAdministrator() || 
        isMonitoringUser()
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow get, list, create, update: if request.auth != null;
      allow delete: if isAdministrator();
    }

    // AUDIT LOGS
    match /audit/{auditId} {
      allow read, create: if request.auth != null;
    }

    // DETECTIONS
    match /detections/{detectionId} {
      allow read, write: if request.auth != null;
    }

    // INCIDENTS & EVENTS
    match /incidents/{incidentId} {
      allow read, write: if request.auth != null;
      match /events/{eventId} {
        allow read, write: if request.auth != null;
      }
    }

    // REPORTS & SUB-EVENTS LOG (FIXED FOR PROTOCOL ACTIONS)
    match /reports/{reportId} {
      allow read, write: if request.auth != null;

      match /events/{eventId} {
        allow read, write: if request.auth != null;
      }
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }

    // CLEANUP REQUESTS
    match /cleanup_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // CAMERA FEEDS
    match /camera_feeds/{cameraId} {
      allow read, write: if request.auth != null;
    }

  }
}